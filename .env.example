# Moodle Login Credentials
MOODLE_USERNAME=your_username
MOODLE_PASSWORD=your_password

# Moodle URLs
LOGIN_URL=https://usi-re.mandiribelajar.co.id/login/index.php
CERT_URL=https://usi-re.mandiribelajar.co.id/mod/customcert/view.php?id=7040
CLASS_URL=https://usi-re.mandiribelajar.co.id/course/view.php?id=80

# Google Drive Settings
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
# Get the folder ID from the Google Drive URL: 
# https://drive.google.com/drive/folders/YOUR_FOLDER_ID_HERE

# Range Siswa (Opsional - untuk membagi beban 2 browser paralel)
# Angka berdasarkan urutan nomor di data.js (1-based index)
# Browser 1: START_INDEX=1, END_INDEX=60
# Browser 2: START_INDEX=61, END_INDEX=121
START_INDEX=1
END_INDEX=60

# Google Drive Credentials Path (relative to project root)
GOOGLE_CREDENTIALS_PATH=./credentials.json
